@model IEnumerable<WebApplication1.Models.Movie>

@{
    ViewData["Title"] = "Movies Catalog";
}

<!-- Barem: Nota 2 & 4 - Catalogul public de filme pentru clienți (Client UI) -->
<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-dark">🎬 Now Playing in Cinemas</h1>
        <p class="text-muted lead">Choose your favorite movie and book your tickets instantly.</p>
    </div>

    <!-- Grila de filme pentru clienți -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden movie-card">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://picsum.photos/300/200" : item.ImageUrl)"
                             class="card-img-top" alt="@item.Title" style="height: 280px; object-fit: cover;">

                        <div class="card-body d-flex flex-column p-4">
                            <h4 class="card-title fw-bold text-dark mb-2">@item.Title</h4>
                            <div class="mb-3">
                                <span class="badge bg-primary px-2 py-1">@item.Genre</span>
                                <span class="text-muted ms-2 small"><i class="bi bi-clock"></i> @item.Duration min</span>
                            </div>

                            <!-- Butonul dedicat clientului (Detalii / Rezervare) -->
                            <div class="mt-auto pt-3">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark w-100 rounded-pill fw-semibold">
                                    View Details & Book
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info py-4 rounded-4 shadow-sm">
                    <h4>No movies available at the moment.</h4>
                    <p class="text-muted mb-0">Please check back later or add movies from the Admin Panel.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .movie-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1) !important;
        }
</style>