@model WebApplication1.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="container my-5 text-center text-light">
    <div class="card border border-secondary border-opacity-25 shadow-lg p-4 p-md-5 rounded-3 text-light mx-auto" style="max-width: 650px; background-color: #12141a;">
        <div class="display-1 text-cinema-orange mb-2">🎟️</div>
        <h2 class="fw-bold text-white mb-2">Booking Confirmed Successfully!</h2>
        <p class="text-secondary fs-6 mb-4">Thank you for choosing Cinema City. Your ticket is ready.</p>

        <!-- Ticket Stilizat Cinema City -->
        <div class="p-4 rounded-3 text-start mb-4 shadow-sm border border-secondary border-opacity-25 position-relative overflow-hidden" style="background-color: #1a1d26;">
            <div class="position-absolute top-0 start-0 bottom-0" style="width: 5px; background-color: #ff6b00;"></div>

            <div class="ps-2">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="fw-bold text-cinema-orange tracking-wide">CINEMA CITY TICKET</span>
                    <span class="badge bg-secondary px-2 py-1">ID: #@Model.Id</span>
                </div>

                <div class="mb-2">
                    <span class="text-secondary small d-block">MOVIE</span>
                    <strong class="fs-4 text-white">@Model.Screening?.Movie?.Title</strong>
                </div>

                <div class="row g-3 my-1">
                    <div class="col-6">
                        <span class="text-secondary small d-block">DATE & TIME</span>
                        <strong class="text-light">@Model.Screening?.Showtime.ToString("dd MMM yyyy, HH:mm")</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-secondary small d-block">HALL</span>
                        <strong class="text-light">@Model.Screening?.HallName</strong>
                    </div>
                </div>

                <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small d-block">RESERVED SEATS</span>
                        <span class="badge bg-cinema-orange fs-6 px-3 py-2 mt-1">@Model.SeatNumbers</span>
                    </div>
                    <div class="text-end">
                        <span class="text-secondary small d-block">BOOKING DATE</span>
                        <small class="text-secondary">@Model.BookingDate.ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <a asp-controller="Movies" asp-action="Index" class="btn btn-cinema-orange btn-lg px-4 py-2 rounded-1 fw-bold shadow-sm">
                ← Back to Movies Catalog
            </a>
        </div>
    </div>
</div>

<style>
    .text-cinema-orange {
        color: #ff6b00 !important;
    }

    .bg-cinema-orange {
        background-color: #ff6b00 !important;
        color: #ffffff !important;
    }

    .btn-cinema-orange {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        transition: all 0.2s ease;
    }

        .btn-cinema-orange:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            color: #ffffff !important;
            box-shadow: 0 0 15px rgba(255, 107, 0, 0.4);
        }
</style>