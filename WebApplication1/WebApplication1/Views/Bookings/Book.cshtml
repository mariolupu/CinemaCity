@model WebApplication1.Models.Screening

@{
    ViewData["Title"] = "Book Seats - " + Model.Movie?.Title;
    var bookedSeats = ViewBag.BookedSeats as List<string> ?? new List<string>();
}

<div class="container my-5 text-center text-light">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="fw-bold mb-2 text-white">🎟️ Cinema Seat Reservation</h1>
            <p class="text-secondary fs-5 mb-4">
                Movie: <span class="text-cinema-orange fw-bold">@Model.Movie?.Title</span> |
                Time: <span class="text-white fw-semibold">@Model.Showtime.ToString("dd MMM yyyy, HH:mm")</span> |
                Hall: <span class="badge bg-secondary px-2 py-1">@Model.HallName</span>
            </p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger w-50 mx-auto rounded-1 shadow-sm border-0">@TempData["Error"]</div>
            }

            <!-- Ecranul cinematografului stilizat Dark & Orange -->
            <div class="screen-container my-4">
                <div class="screen">CINEMA SCREEN</div>
            </div>

            <!-- Legendă -->
            <div class="d-flex justify-content-center gap-4 mb-4 text-light small fw-semibold">
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-sample seat-available"></span> Available
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-sample seat-selected"></span> Selected
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-sample seat-occupied"></span> Occupied
                </div>
            </div>

            <!-- Hartă scaune pe fundal Gri Închis (#12141a) -->
            <form asp-action="Book" method="post" id="bookingForm">
                <input type="hidden" name="screeningId" value="@Model.Id" />
                <input type="hidden" id="selectedSeatsInput" name="selectedSeats" />

                <div class="seat-grid-container mx-auto mb-4 p-4 rounded-3 shadow-lg border border-secondary border-opacity-25 d-inline-block text-center" style="background-color: #12141a;">
                    @Html.Raw(RenderSeatRow("A", 8, bookedSeats))
                    @Html.Raw(RenderSeatRow("B", 10, bookedSeats))
                    @Html.Raw(RenderSeatRow("C", 12, bookedSeats))
                    @Html.Raw(RenderSeatRow("D", 14, bookedSeats))
                    @Html.Raw(RenderSeatRow("E", 14, bookedSeats))
                    @Html.Raw(RenderSeatRow("F", 16, bookedSeats))
                </div>

                <!-- Panou de confirmare stilizat Gri Închis -->
                <div class="card border border-secondary border-opacity-25 shadow-lg p-4 w-75 mx-auto rounded-3 text-center mb-4" style="background-color: #161920;">
                    <h5 class="text-white mb-3">Selected Seats: <span id="selectedSeatsText" class="text-cinema-orange fw-bold">None</span></h5>
                    <button type="submit" class="btn btn-cinema-orange btn-lg px-5 py-2 rounded-1 fw-bold shadow-sm" onclick="prepareSubmit()">
                        Confirm Booking 🚀
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    string RenderSeatRow(string rowLetter, int totalSeats, List<string> bookedSeats)
    {
        var html = $"<div class='d-flex align-items-center justify-content-center mb-2 gap-1'>";
        html += $"<span class='fw-bold text-cinema-orange me-3' style='width: 25px;'>{rowLetter}</span>";

        int middle = totalSeats / 2;
        for (int i = 1; i <= totalSeats; i++)
        {
            var seatId = $"{rowLetter}{i}";
            var isBooked = bookedSeats.Contains(seatId);

            if (i == middle + 1)
            {
                html += "<div style='width: 35px;'></div>";
            }

            if (isBooked)
            {
                html += $"<button type='button' class='btn seat-btn seat-occupied disabled' disabled title='Occupied'>{i}</button>";
            }
            else
            {
                html += $"<button type='button' class='btn seat-btn seat-available' data-seat='{seatId}' onclick='toggleSeat(this)'>{i}</button>";
            }
        }
        html += "</div>";
        return html;
    }
}

<style>
    .text-cinema-orange {
        color: #ff6b00 !important;
    }

    .screen-container {
        perspective: 500px;
    }

    .screen {
        background: linear-gradient(to bottom, #ff6b00, #331500);
        color: white;
        font-weight: 800;
        letter-spacing: 4px;
        padding: 10px;
        width: 65%;
        margin: 0 auto;
        border-radius: 4px;
        transform: rotateX(-20deg);
        box-shadow: 0 10px 25px rgba(255, 107, 0, 0.3);
        border-bottom: 2px solid #ff6b00;
    }

    .seat-sample {
        width: 18px;
        height: 18px;
        display: inline-block;
        border-radius: 4px;
    }

    /* Stilizare curată pentru butoanele de scaune (Eliminat aspectul pixelat prin raze de 4px și anti-aliasing) */
    .seat-btn {
        width: 38px;
        height: 38px;
        font-size: 0.8rem;
        font-weight: 700;
        border-radius: 4px !important;
        transition: all 0.2s ease-in-out;
        padding: 0;
        line-height: 38px;
        outline: none !important;
        box-shadow: none !important;
    }

    /* Scaune Disponibile - Gri Închis fin */
    .seat-available {
        background-color: #262933 !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
    }

        .seat-available:hover {
            background-color: #ff6b00 !important;
            border-color: #ff6b00 !important;
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 0, 0.4) !important;
        }

    /* Scaune Selectate - Portocaliu Vibrant */
    .seat-selected {
        background-color: #ff6b00 !important;
        color: #ffffff !important;
        border: 1px solid #ff6b00 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 107, 0, 0.6) !important;
    }

    /* Scaune Rezervate - Negru Complet */
    .seat-occupied {
        background-color: #000000 !important;
        color: #444444 !important;
        border: 1px solid #141414 !important;
        cursor: not-allowed;
    }

    .btn-cinema-orange {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        border-radius: 4px !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-cinema-orange:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            box-shadow: 0 0 15px rgba(255, 107, 0, 0.4);
        }
</style>

<script>
    let selectedSeats = [];

    function toggleSeat(button) {
        let seat = button.getAttribute("data-seat");
        if (selectedSeats.includes(seat)) {
            selectedSeats = selectedSeats.filter(s => s !== seat);
            button.classList.remove("seat-selected");
            button.classList.add("seat-available");
        } else {
            selectedSeats.push(seat);
            button.classList.remove("seat-available");
            button.classList.add("seat-selected");
        }
        document.getElementById("selectedSeatsText").innerText = selectedSeats.length > 0 ? selectedSeats.join(", ") : "None";
    }

    function prepareSubmit() {
        document.getElementById("selectedSeatsInput").value = selectedSeats.join(",");
    }
</script>