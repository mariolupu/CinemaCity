@model IEnumerable<WebApplication1.Models.Promotion>

@{
    ViewData["Title"] = "Manage Promotions";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-dark">⚙️ Manage Promotions & Offers</h1>
            <p class="text-muted">Add, edit, or remove promotional banners shown in the main carousel.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
            ➕ Add New Promotion
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 ps-4">Badge</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Discount / Price</th>
                        <th class="py-3">Days</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-secondary px-2 py-1">@item.BadgeText</span>
                            </td>
                            <td class="fw-bold text-dark">@item.Title</td>
                            <td>
                                @if (item.DiscountPercentage.HasValue)
                                {
                                    <span class="text-success fw-bold">@item.DiscountPercentage% OFF</span>
                                }
                                else if (item.FixedPrice.HasValue)
                                {
                                    <span class="text-info fw-bold">@item.FixedPrice RON</span>
                                }
                                else
                                {
                                    <span class="text-muted">Standard</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(item.ApplicableDays) ? "All days" : item.ApplicableDays)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>