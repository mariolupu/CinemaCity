@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-white fw-semibold d-flex align-items-center gap-1 px-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Account">
                <i class="bi bi-person-circle text-cinema-orange fs-5"></i>
                <span class="text-light">@User.Identity?.Name</span>
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-outline-light btn-sm rounded-1 px-3 fw-semibold shadow-sm">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-light fw-semibold px-3 hover-orange" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-cinema-orange btn-sm text-white fw-bold rounded-1 px-3" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Login
            </a>
        </li>
    }
</ul>

<style>
    .text-cinema-orange {
        color: #ff6b00 !important;
    }

    .btn-cinema-orange {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-cinema-orange:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            color: #ffffff !important;
            box-shadow: 0 0 10px rgba(255, 107, 0, 0.4);
        }

    .hover-orange:hover {
        color: #ff6b00 !important;
    }
</style>