@model IEnumerable<WebApplication1.Models.Movie>

@{
    ViewData["Title"] = "Now Playing";
    var movieList = Model.ToList();
    var featuredMovies = movieList.Where(m => m.IsFeatured).ToList();
    var promotions = ViewBag.Promotions as List<WebApplication1.Models.Promotion> ?? new List<WebApplication1.Models.Promotion>();

    int totalSlides = promotions.Count + featuredMovies.Count;
}

<div class="container my-4">

    @if (totalSlides > 0)
    {
        <!-- Cinema City Style Carousel -->
        <div id="cinemaCarousel" class="carousel slide mb-5 shadow-lg rounded-4 overflow-hidden" data-bs-ride="carousel" data-bs-interval="6000">

            <!-- Indicators: Gri vizibil, Alb pur activ -->
            <div class="carousel-indicators">
                @{
                    int slideIndex = 0;
                }
                @foreach (var promo in promotions)
                {
                    <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="@slideIndex" class="@(slideIndex == 0 ? "active" : "")" aria-label="Slide @(slideIndex + 1)"></button>
                    slideIndex++;
                }
                @foreach (var movie in featuredMovies)
                {
                    <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="@slideIndex" class="@(slideIndex == 0 ? "active" : "")" aria-label="Slide @(slideIndex + 1)"></button>
                    slideIndex++;
                }
            </div>

            <div class="carousel-inner">
                @{
                    bool isFirst = true;
                }

                <!-- 1. PROMOȚII / OFERTE -->
                @foreach (var promo in promotions)
                {
                    <div class="carousel-item carousel-slide-custom @(isFirst ? "active" : "")">
                        <img src="@promo.ImageUrl" class="d-block w-100 carousel-img" alt="@promo.Title">
                        <div class="carousel-caption text-start p-4 p-lg-5 rounded-4 animate-caption">
                            <span class="badge badge-cinema-orange mb-2 fw-bold px-3 py-2 rounded-pill shadow-sm">@promo.BadgeText</span>
                            <h1 class="carousel-title text-white text-shadow mb-2">@promo.Title</h1>
                            @if (!string.IsNullOrEmpty(promo.Subtitle))
                            {
                                <h4 class="carousel-subtitle text-cinema-orange fw-bold mb-3 text-shadow">@promo.Subtitle</h4>
                            }
                            <p class="carousel-desc text-light mb-4 text-shadow">@promo.Description</p>
                            <a href="#movies-grid" class="btn btn-cinema-orange btn-md rounded-pill px-4 fw-bold shadow">
                                Explore Movies & Book
                            </a>
                        </div>
                    </div>
                    isFirst = false;
                }

                <!-- 2. FILME DIN CARUSEL (Featured Movies) -->
                @foreach (var movie in featuredMovies)
                {
                    <div class="carousel-item carousel-slide-custom @(isFirst ? "active" : "")">
                        <img src="@(string.IsNullOrEmpty(movie.ImageUrl) ? "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1400&auto=format&fit=crop" : movie.ImageUrl)" class="d-block w-100 carousel-img" alt="@movie.Title">
                        <div class="carousel-caption text-start p-4 p-lg-5 rounded-4 animate-caption">
                            <span class="badge badge-cinema-orange mb-2 fw-bold px-3 py-2 rounded-pill shadow-sm">⭐ FEATURED PREMIERE</span>
                            <h1 class="carousel-title text-white text-shadow mb-2">@movie.Title</h1>
                            <div class="carousel-subtitle text-info fw-bold mb-3 text-shadow">
                                Genre: @movie.Genre &bull; Duration: @(movie.Duration / 60)h @(movie.Duration % 60)m
                            </div>
                            <p class="carousel-desc text-light mb-4 text-shadow">
                                Now playing in our cinemas. Explore showtimes, pick your favorite seats online, and enjoy the ultimate cinematic experience.
                            </p>
                            <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-light btn-md rounded-pill px-4 fw-bold text-dark shadow">
                                🎟️ Reserve Seat Now
                            </a>
                        </div>
                    </div>
                    isFirst = false;
                }

            </div>

            <!-- Săgețile de navigare (Sigure 100% albe, fără bug-uri) -->
            <button class="carousel-control-prev custom-arrow" type="button" data-bs-target="#cinemaCarousel" data-bs-slide="prev">
                <svg class="custom-arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
                </svg>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next custom-arrow" type="button" data-bs-target="#cinemaCarousel" data-bs-slide="next">
                <svg class="custom-arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                </svg>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    }

    <!-- Secțiunea principală -->
    <div id="movies-grid" class="row mb-4 align-items-center">
        <div class="col-md-12">
            <h1 class="display-5 fw-bold text-white">🎬 Now Playing & Blockbusters</h1>
            <p class="text-secondary fs-5">Check out the hottest movies currently running and book your seats online.</p>
        </div>
    </div>

    <!-- Movie Cards Grid -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden movie-card text-light">
                    <div class="poster-container overflow-hidden position-relative" style="height: 280px;">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://picsum.photos/300/200" : item.ImageUrl)"
                             class="card-img-top movie-img w-100 h-100" alt="@item.Title" style="object-fit: cover;">
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h4 class="card-title fw-bold text-white mb-2">@item.Title</h4>
                        <div class="mb-3">
                            <span class="badge bg-secondary px-2 py-1">@item.Genre</span>
                            @{
                                int hours = item.Duration / 60;
                                int minutes = item.Duration % 60;
                                string formattedDuration = hours > 0 ? $"{hours}h {minutes}min" : $"{minutes}min";
                            }
                            <span class="text-secondary ms-2 small"><i class="bi bi-clock"></i> @formattedDuration</span>
                        </div>

                        <div class="mt-auto pt-3 d-flex justify-content-between align-items-center border-top border-secondary border-opacity-25">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-light btn-sm rounded-pill px-3 shadow-sm">
                                View Details
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-cinema-orange btn-sm rounded-pill px-3 fw-semibold shadow-sm text-white">
                                🎟️ Book Seat
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- STILIZARE CINEMA CITY -->
<style>
    /* Săgeți de navigare curate, albe și perfect clicabile */
    .custom-arrow {
        z-index: 20 !important;
        cursor: pointer;
        width: 8%;
        opacity: 0.8;
        background: transparent !important;
        border: none !important;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

        .custom-arrow:hover {
            opacity: 1;
            transform: scale(1.15);
        }

    .custom-arrow-icon {
        width: 2.5rem;
        height: 2.5rem;
        color: #ffffff !important;
        filter: drop-shadow(0px 2px 6px rgba(0, 0, 0, 0.9));
    }

    /* Indicatorii (liniile de jos) */
    .carousel-indicators {
        z-index: 15;
        margin-bottom: 1rem;
    }

        .carousel-indicators button {
            background-color: rgba(255, 255, 255, 0.4) !important;
            border: none !important;
            height: 4px !important;
            border-radius: 2px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .carousel-indicators button.active {
                background-color: #ffffff !important;
                width: 35px !important;
                box-shadow: 0 0 10px rgba(255, 107, 0, 0.8);
            }

    .text-cinema-orange {
        color: #ff6b00 !important;
    }

    .btn-cinema-orange {
        background-color: #ff6b00;
        border-color: #ff6b00;
        color: #fff;
        transition: all 0.2s ease-in-out;
    }

        .btn-cinema-orange:hover {
            background-color: #e56000;
            border-color: #e56000;
            color: #fff;
        }

    .badge-cinema-orange {
        background-color: #ff6b00;
        color: #fff;
    }

    .carousel-slide-custom {
        height: 480px;
        background-color: #0b0c10;
    }

    .carousel-img {
        height: 480px;
        object-fit: cover;
        filter: brightness(55%);
        transform: scale(1);
        transition: transform 10s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .carousel-item.active .carousel-img {
        transform: scale(1.06);
    }

    .carousel-caption {
        background: linear-gradient(to right, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 70%, rgba(0, 0, 0, 0) 100%);
        backdrop-filter: blur(4px);
        border-radius: 1rem;
        bottom: 3.5rem;
        left: 2rem;
        right: 2rem;
        max-width: 700px;
        text-align: left !important;
        z-index: 5;
        opacity: 0;
        transform: translateY(25px);
    }

    .carousel-title {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        line-height: 1.2;
    }

    .carousel-subtitle {
        font-size: 1.1rem;
    }

    .carousel-desc {
        font-size: 0.95rem;
        line-height: 1.5;
        opacity: 0.9;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .text-shadow {
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
    }

    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .carousel-item.active .animate-caption {
        animation: slideUpFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .movie-card {
        background-color: #161920 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out, border-color 0.3s ease;
    }

        .movie-card:hover {
            transform: translateY(-6px);
            border-color: rgba(255, 107, 0, 0.4) !important;
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.4) !important;
        }

    .movie-img {
        transition: transform 0.5s ease-in-out;
    }

    .movie-card:hover .movie-img {
        transform: scale(1.06);
    }
</style>