@model IEnumerable<WebApplication1.Models.Movie>

@{
    ViewData["Title"] = "Now Playing";
    var movieList = Model.ToList();
    var featuredMovies = movieList.Where(m => m.IsFeatured).ToList();
    var promotions = ViewBag.Promotions as List<WebApplication1.Models.Promotion> ?? new List<WebApplication1.Models.Promotion>();

    int totalSlides = promotions.Count + featuredMovies.Count;
    var customSections = movieList.Where(m => !string.IsNullOrEmpty(m.HomeSection)).Select(m => m.HomeSection).Distinct().ToList();
}

<div class="container-fluid px-3 px-md-5 my-4 text-light main-cinema-bg smooth-render position-relative overflow-hidden">

    <div class="cinema-spotlight spotlight-1"></div>
    <div class="cinema-spotlight spotlight-2"></div>
    <div class="cinema-spotlight spotlight-3"></div>
    <div class="cinema-spotlight spotlight-4"></div>
    <div class="cinema-spotlight spotlight-5"></div>
    <div class="cinema-spotlight spotlight-6"></div>
    <div class="cinema-spotlight spotlight-7"></div>
    <div class="cinema-spotlight spotlight-8"></div>

    @if (totalSlides > 0)
    {
        <div class="row justify-content-center pt-4 pt-md-5 mb-5 pb-4 position-relative" style="z-index: 2;">
            <div class="col-11 col-lg-9 col-xl-8 col-xxl-7">
                <div id="cinemaCarousel" class="carousel slide shadow-lg rounded-3 overflow-hidden position-relative hero-tall" data-bs-ride="carousel" data-bs-interval="6000">

                    <div class="carousel-indicators">
                        @{
                            int slideIndex = 0;
                        }
                        @foreach (var promo in promotions)
                        {
                            <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="@slideIndex" class="@(slideIndex == 0 ? "active" : "")" aria-label="Slide @(slideIndex + 1)"></button>
                            slideIndex++;
                        }
                        @foreach (var movie in featuredMovies)
                        {
                            <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="@slideIndex" class="@(slideIndex == 0 ? "active" : "")" aria-label="Slide @(slideIndex + 1)"></button>
                            slideIndex++;
                        }
                    </div>

                    <div class="carousel-inner">
                        @{
                            bool isFirst = true;
                        }

                        @foreach (var promo in promotions)
                        {
                            <div class="carousel-item carousel-slide-custom @(isFirst ? "active" : "")">
                                <div class="carousel-img-wrapper">
                                    <img src="@promo.ImageUrl" class="d-block w-100 carousel-img" alt="@promo.Title">
                                </div>
                                <div class="carousel-caption text-start p-4 p-lg-5 rounded-3 animate-caption">
                                    <span class="badge badge-cinema-orange mb-2 fw-bold px-3 py-2 rounded-1 shadow-sm">@promo.BadgeText</span>
                                    <h1 class="carousel-title text-white text-shadow mb-2">@promo.Title</h1>
                                    @if (!string.IsNullOrEmpty(promo.Subtitle))
                                    {
                                        <h4 class="carousel-subtitle text-cinema-orange fw-bold mb-3 text-shadow">@promo.Subtitle</h4>
                                    }
                                    <p class="carousel-desc text-light mb-4 text-shadow">@promo.Description</p>
                                    <a href="#movies-grid" class="btn btn-cinema-orange btn-md rounded-1 px-4 fw-bold shadow">
                                        Explore Movies & Book
                                    </a>
                                </div>
                            </div>
                            isFirst = false;
                        }

                        @foreach (var movie in featuredMovies)
                        {
                            <div class="carousel-item carousel-slide-custom @(isFirst ? "active" : "")">
                                <div class="carousel-img-wrapper">
                                    <img src="@(string.IsNullOrEmpty(movie.ImageUrl) ? "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1400&auto=format&fit=crop" : movie.ImageUrl)" class="d-block w-100 carousel-img" alt="@movie.Title">
                                </div>
                                <div class="carousel-caption text-start p-4 p-lg-5 rounded-3 animate-caption">
                                    <span class="badge badge-cinema-orange mb-2 fw-bold px-3 py-2 rounded-1 shadow-sm">⭐ FEATURED PREMIERE</span>
                                    <h1 class="carousel-title text-white text-shadow mb-2">@movie.Title</h1>
                                    <div class="carousel-subtitle text-cinema-orange fw-bold mb-3 text-shadow">
                                        Genre: @movie.Genre &bull; Duration: @(movie.Duration / 60)h @(movie.Duration % 60)m
                                    </div>
                                    <p class="carousel-desc text-light mb-4 text-shadow">
                                        Now playing in our cinemas. Explore showtimes, pick your favorite seats online, and enjoy the ultimate cinematic experience.
                                    </p>
                                    <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-light btn-md rounded-1 px-4 fw-bold text-dark shadow">
                                        🎟️ Reserve Seat Now
                                    </a>
                                </div>
                            </div>
                            isFirst = false;
                        }
                    </div>

                    <!-- Săgeți carusel principal -->
                    <button class="carousel-control-prev custom-arrow" type="button" data-bs-target="#cinemaCarousel" data-bs-slide="prev">
                        <svg class="custom-arrow-icon" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="12 4 4 16 12 28"></polyline>
                        </svg>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next custom-arrow" type="button" data-bs-target="#cinemaCarousel" data-bs-slide="next">
                        <svg class="custom-arrow-icon" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="4 4 12 16 4 28"></polyline>
                        </svg>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- RÂNDURI TEMATICE -->
    @if (customSections.Any())
    {
        int sectionCounter = 0;
        @foreach (var section in customSections)
        {
            var sectionMovies = movieList.Where(m => m.HomeSection == section).ToList();
            if (sectionMovies.Any())
            {
                string sectionSliderId = "movieSlider_" + sectionCounter;

                <div class="row justify-content-center mb-5 position-relative" style="z-index: 2;">
                    <div class="col-12 col-xl-10 col-xxl-9">
                        <div class="d-flex justify-content-between align-items-center mb-3 px-4">
                            <h3 class="fw-bold text-white border-start border-4 border-cinema-orange ps-3 m-0 fs-4">
                                🎬 @(section)
                            </h3>
                        </div>

                        <div class="movie-slider-wrapper position-relative px-5">
                            <button class="slider-arrow slider-arrow-left" data-target="@sectionSliderId">
                                <svg class="slider-arrow-icon" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="12 4 4 16 12 28"></polyline>
                                </svg>
                            </button>

                            <div id="@sectionSliderId" class="movie-horizontal-slider d-flex gap-3 overflow-x-auto pt-2 pb-3">
                                @foreach (var item in sectionMovies)
                                {
                                    <div class="movie-slider-item flex-shrink-0" style="width: calc((100% - 80px) / 6); min-width: 155px;">
                                        <div class="card h-100 shadow-sm border border-secondary border-opacity-25 rounded-3 movie-card text-light">
                                            <div class="poster-container overflow-hidden position-relative rounded-top-3" style="height: 190px;">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://picsum.photos/300/200" : item.ImageUrl)"
                                                     class="card-img-top movie-img w-100 h-100" alt="@item.Title" style="object-fit: cover;">
                                            </div>
                                            <div class="card-body d-flex flex-column p-2 p-sm-3">
                                                <h6 class="card-title fw-bold text-white mb-1 text-truncate" title="@item.Title" style="font-size: 0.85rem;">@item.Title</h6>
                                                <div class="mb-2 d-flex align-items-center justify-content-between gap-1 flex-wrap">
                                                    <span class="badge bg-secondary" style="font-size: 0.65rem;" title="@item.Genre">@item.Genre</span>
                                                    @{
                                                        int hours = item.Duration / 60;
                                                        int minutes = item.Duration % 60;
                                                        string formattedDuration = hours > 0 ? $"{hours}h {minutes}m" : $"{minutes}m";
                                                    }
                                                    <span class="text-secondary small text-nowrap" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>@formattedDuration</span>
                                                </div>
                                                <div class="mt-auto pt-2 border-top border-secondary border-opacity-25">
                                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-cinema-orange w-100 rounded-1 fw-bold shadow-sm text-white py-1 btn-sm text-nowrap" style="font-size: 0.75rem;">
                                                        🎟️ Book Seat
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <button class="slider-arrow slider-arrow-right" data-target="@sectionSliderId">
                                <svg class="slider-arrow-icon" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="4 4 12 16 4 28"></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                if (sectionCounter == 0)
                {
                    <div class="row justify-content-center my-5 position-relative" style="z-index: 2;">
                        <div class="col-12 col-xl-10 col-xxl-9">
                            <div class="row g-4 py-3 px-1 px-md-3">
                                <div class="col-md-4">
                                    <div class="card marketing-box h-100 p-4 rounded-3 text-light shadow-sm">
                                        <div class="mb-3 text-cinema-orange fs-2">⚡</div>
                                        <h5 class="fw-bold text-white mb-2">Fast Booking 24/7</h5>
                                        <p class="text-secondary small mb-0">Choose your favorite movie, pick the best seats in the cinema hall directly from your phone or PC without queuing.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card marketing-box h-100 p-4 rounded-3 text-light shadow-sm">
                                        <div class="mb-3 text-cinema-orange fs-2">🍿</div>
                                        <h5 class="fw-bold text-white mb-2">Bar & Snacks Menus</h5>
                                        <p class="text-secondary small mb-0">Enjoy the complete experience with fresh popcorn, crunchy nachos with cheese sauce, and refreshing drinks at special prices.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card marketing-box h-100 p-4 rounded-3 text-light shadow-sm">
                                        <div class="mb-3 text-cinema-orange fs-2">👑</div>
                                        <h5 class="fw-bold text-white mb-2">VIP Experience & Premium Halls</h5>
                                        <p class="text-secondary small mb-0">Discover comfortable reclining armchairs, state-of-the-art Dolby Atmos surround sound, and flawless visual quality.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                sectionCounter++;
            }
        }
    }

    <!-- ALL BLOCKBUSTERS & MOVIES -->
    <div class="row justify-content-center position-relative" style="z-index: 2;">
        <div class="col-12 col-xl-10 col-xxl-9">
            <div id="movies-grid" class="row mb-4 align-items-center mt-4 px-4">
                <div class="col-md-12">
                    <h2 class="fw-bold text-white fs-3">🎬 All Blockbusters & Movies</h2>
                    <p class="text-secondary small mb-0">Check out the complete movie catalog currently running in our cinemas.</p>
                </div>
            </div>

            <div class="movie-slider-wrapper position-relative px-5 mb-5">
                <button class="slider-arrow slider-arrow-left" data-target="allMoviesSlider">
                    <svg class="slider-arrow-icon" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="12 4 4 16 12 28"></polyline>
                    </svg>
                </button>

                <div id="allMoviesSlider" class="movie-horizontal-slider d-flex gap-3 overflow-x-auto pt-2 pb-3">
                    @foreach (var item in movieList)
                    {
                        <div class="movie-slider-item flex-shrink-0" style="width: calc((100% - 80px) / 6); min-width: 155px;">
                            <div class="card h-100 shadow-sm border border-secondary border-opacity-25 rounded-3 movie-card text-light">
                                <div class="poster-container overflow-hidden position-relative rounded-top-3" style="height: 190px;">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://picsum.photos/300/200" : item.ImageUrl)"
                                         class="card-img-top movie-img w-100 h-100" alt="@item.Title" style="object-fit: cover;">
                                </div>
                                <div class="card-body d-flex flex-column p-2 p-sm-3">
                                    <h6 class="card-title fw-bold text-white mb-1 text-truncate" title="@item.Title" style="font-size: 0.85rem;">@item.Title</h6>
                                    <div class="mb-2 d-flex align-items-center justify-content-between gap-1 flex-wrap">
                                        <span class="badge bg-secondary" style="font-size: 0.65rem;" title="@item.Genre">@item.Genre</span>
                                        @{
                                            int hours = item.Duration / 60;
                                            int minutes = item.Duration % 60;
                                            string formattedDuration = hours > 0 ? $"{hours}h {minutes}m" : $"{minutes}m";
                                        }
                                        <span class="text-secondary small text-nowrap" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>@formattedDuration</span>
                                    </div>
                                    <div class="mt-auto pt-2 border-top border-secondary border-opacity-25">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-cinema-orange w-100 rounded-1 fw-bold shadow-sm text-white py-1 btn-sm text-nowrap" style="font-size: 0.75rem;">
                                            🎟️ Book Seat
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button class="slider-arrow slider-arrow-right" data-target="allMoviesSlider">
                    <svg class="slider-arrow-icon" viewBox="0 0 16 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="4 4 12 16 4 28"></polyline>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        function updateArrowVisibility(slider) {
            const wrapper = slider.closest(".movie-slider-wrapper");
            if (!wrapper) return;

            const leftArrow = wrapper.querySelector(".slider-arrow-left");
            const rightArrow = wrapper.querySelector(".slider-arrow-right");

            const scrollLeft = slider.scrollLeft;
            const maxScroll = slider.scrollWidth - slider.clientWidth;

            if (leftArrow) {
                if (scrollLeft <= 2) {
                    leftArrow.classList.add("is-hidden");
                } else {
                    leftArrow.classList.remove("is-hidden");
                }
            }

            if (rightArrow) {
                if (scrollLeft >= maxScroll - 2 || maxScroll <= 0) {
                    rightArrow.classList.add("is-hidden");
                } else {
                    rightArrow.classList.remove("is-hidden");
                }
            }
        }

        document.querySelectorAll(".movie-horizontal-slider").forEach(slider => {
            updateArrowVisibility(slider);

            slider.addEventListener("scroll", function () {
                updateArrowVisibility(this);
            });
        });

        document.querySelectorAll(".slider-arrow-left").forEach(button => {
            button.addEventListener("click", function () {
                const targetId = this.getAttribute("data-target");
                const slider = document.getElementById(targetId);
                if (slider) {
                    const cardItem = slider.querySelector(".movie-slider-item");
                    const scrollAmount = cardItem ? cardItem.offsetWidth + 16 : 200;
                    slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                }
            });
        });

        document.querySelectorAll(".slider-arrow-right").forEach(button => {
            button.addEventListener("click", function () {
                const targetId = this.getAttribute("data-target");
                const slider = document.getElementById(targetId);
                if (slider) {
                    const cardItem = slider.querySelector(".movie-slider-item");
                    const scrollAmount = cardItem ? cardItem.offsetWidth + 16 : 200;
                    slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            });
        });

        window.addEventListener("resize", function () {
            document.querySelectorAll(".movie-horizontal-slider").forEach(slider => {
                updateArrowVisibility(slider);
            });
        });
    });
</script>