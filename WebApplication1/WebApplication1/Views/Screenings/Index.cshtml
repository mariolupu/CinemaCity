@model IEnumerable<WebApplication1.Models.Screening>

@{
    ViewData["Title"] = "Manage Screenings";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">🎬 Manage Showtimes & Screenings</h1>
            <p class="text-muted">Add dates, showtimes, and hall assignments for movies.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">
            + Add New Showtime
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Movie Title</th>
                        <th>Showtime Date & Time</th>
                        <th>Cinema Hall</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.Movie?.Title</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2">
                                    🕒 @item.Showtime.ToString("dd MMM yyyy, HH:mm")
                                </span>
                            </td>
                            <td><span class="badge bg-secondary">@item.HallName</span></td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onclick="return confirm('Are you sure you want to delete this showtime?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No showtimes found. Click <strong>+ Add New Showtime</strong> to schedule one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>