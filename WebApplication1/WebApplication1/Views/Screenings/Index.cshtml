@model IEnumerable<WebApplication1.Models.Screening>

@{
    ViewData["Title"] = "Manage Screenings";
}

<div class="container my-4 text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold text-white">🕒 Screenings Management</h1>
            <p class="text-secondary">Manage movie showtimes and cinema halls.</p>
        </div>
        <a asp-action="Create" class="btn btn-cinema-orange rounded-pill px-4 fw-bold shadow-sm">
            + Add New Screening
        </a>
    </div>

    <div class="card border-0 cinema-card-inner rounded-4 shadow-lg overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th class="ps-4">Movie Title</th>
                        <th>Showtime</th>
                        <th>Hall Name</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-white">@(item.Movie?.Title ?? "N/A")</td>
                            <td><span class="badge bg-warning text-dark px-3 py-2">@item.Showtime.ToString("dd MMM yyyy, HH:mm")</span></td>
                            <td><span class="text-info fw-semibold">@item.HallName</span></td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this screening?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-secondary fst-italic">No screenings scheduled yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .btn-cinema-orange {
        background-color: #ff6b00;
        border-color: #ff6b00;
        color: #fff;
        transition: all 0.2s ease-in-out;
    }

        .btn-cinema-orange:hover {
            background-color: #e56000;
            border-color: #e56000;
            color: #fff;
        }

    .cinema-card-inner {
        background-color: #161920 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
</style>