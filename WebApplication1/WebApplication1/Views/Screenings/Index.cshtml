@model IEnumerable<WebApplication1.Models.Movie>

@{
    ViewData["Title"] = "Movies Catalog";
    var movieList = Model.ToList();
}

<!-- Barem: Nota 2 & 4 - Interfață grafică modernă, dinamică și carusel stil Cinema City -->
<div class="container my-4">

    <!-- Carusel Stil Cinema City (Oferte & Filme) -->
    <div id="cinemaCarousel" class="carousel slide mb-5 shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            @if (movieList.Count > 0)
            {
                <button type="button" data-bs-target="#cinemaCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            }
        </div>

        <div class="carousel-inner">

            <!-- SLIDE 1: Meniul Studentului / Ofertă Specială -->
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1585647347384-2593bc35786b?q=80&w=1200&auto=format&fit=crop" class="d-block w-100 carousel-img" alt="Student Offer">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded-4 p-4 text-start shadow">
                    <span class="badge bg-warning text-dark mb-2 fw-bold px-3 py-2">🍿 STUDENT & YOUTH DISCOUNT</span>
                    <h2 class="fw-bold text-white display-6">Meniul Studentului: Popcorn + Suc Moca!</h2>
                    <p class="text-light fs-6 mb-3">Arată carnetul de student la barul cinematografului și primești <strong>20% reducere</strong> la orice bilet + refill gratuit la popcorn!</p>
                    <a href="#movies-grid" class="btn btn-warning btn-sm rounded-pill px-4 fw-bold shadow-sm">
                        Vezi Filmele & Rezervă Locul
                    </a>
                </div>
            </div>

            <!-- SLIDE 2: Miercurea Cinematografică / Reducere Bilete -->
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1200&auto=format&fit=crop" class="d-block w-100 carousel-img" alt="Promo Wednesday">
                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded-4 p-4 text-start shadow">
                    <span class="badge bg-danger mb-2 fw-bold px-3 py-2">🔥 CINEMA CITY SPECIAL</span>
                    <h2 class="fw-bold text-white display-6">Miercurea Cinematografică - Bilete la 15 LEI</h2>
                    <p class="text-light fs-6 mb-3">În fiecare zi de miercuri, toate filmele 2D și 3D au un preț unic promoțional pentru toți iubitorii de film.</p>
                    <a href="#movies-grid" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold shadow-sm">
                        Alege Filmul de Miercuri
                    </a>
                </div>
            </div>

            <!-- SLIDE 3: Primul film din baza de date (Dacă există) -->
            @if (movieList.Count > 0)
            {
                var featuredMovie = movieList[0];
                <div class="carousel-item">
                    <img src="@(string.IsNullOrEmpty(featuredMovie.ImageUrl) ? "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=1200&auto=format&fit=crop" : featuredMovie.ImageUrl)" class="d-block w-100 carousel-img" alt="@featuredMovie.Title">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded-4 p-4 text-start shadow">
                        <span class="badge bg-info text-dark mb-2 fw-bold px-3 py-2">⭐ RECOMANDAREA SĂPTĂMÂNII</span>
                        <h2 class="fw-bold text-white display-6">@featuredMovie.Title</h2>
                        <p class="text-light fs-6 mb-3">
                            Gen: <strong>@featuredMovie.Genre</strong> |
                            Durată: <strong>@(featuredMovie.Duration / 60)h @(featuredMovie.Duration % 60)min</strong>
                        </p>
                        <a asp-action="Details" asp-route-id="@featuredMovie.Id" class="btn btn-light btn-sm rounded-pill px-4 fw-bold text-dark shadow-sm">
                            🎟️ Cumpară Bilet / Rezervă
                        </a>
                    </div>
                </div>
            }

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#cinemaCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#cinemaCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Header-ul catalogului de filme -->
    <div id="movies-grid" class="row mb-4 align-items-center">
        <div class="col-md-12">
            <h1 class="display-5 fw-bold text-dark">🎬 Movies Catalog</h1>
            <p class="text-muted fs-5">Explore our current movie selection available for online seat booking.</p>
        </div>
    </div>

    <!-- Grila de filme (Carduri moderne responsive) -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden movie-card">
                    <!-- Posterul filmului cu efect de zoom la hover -->
                    <div class="poster-container overflow-hidden position-relative" style="height: 250px;">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=400&auto=format&fit=crop" : item.ImageUrl)"
                             class="card-img-top movie-img w-100 h-100" alt="@item.Title" style="object-fit: cover;">
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h4 class="card-title fw-bold text-dark mb-2">@item.Title</h4>
                        <div class="mb-3">
                            <span class="badge bg-secondary px-2 py-1">@item.Genre</span>
                            @{
                                int hours = item.Duration / 60;
                                int minutes = item.Duration % 60;
                                string formattedDuration = hours > 0 ? $"{hours}h {minutes}min" : $"{minutes}min";
                            }
                            <span class="text-muted ms-2 small"><i class="bi bi-clock"></i> @formattedDuration</span>
                        </div>

                        <!-- Butoane de acțiune -->
                        <div class="mt-auto pt-3 d-flex justify-content-between align-items-center border-top">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm rounded-pill px-3 shadow-sm">
                                View Details
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold shadow-sm">
                                🎟️ Book Seat
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Stilizare CSS pentru carusel și carduri -->
<style>
    .carousel-img {
        height: 380px;
        object-fit: cover;
        filter: brightness(75%);
    }

    .movie-card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        background-color: #f8f9fa;
    }

        .movie-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.15) !important;
            background-color: #ffffff;
        }

    .movie-img {
        transition: transform 0.5s ease-in-out;
    }

    .movie-card:hover .movie-img {
        transform: scale(1.06);
    }
</style>