@model WebApplication1.Models.Screening

@{
    ViewData["Title"] = "Add Showtime";
}

<div class="container my-5 text-light">
    <div class="col-md-6 mx-auto">
        <div class="card border border-secondary border-opacity-25 rounded-3 p-4 shadow-lg" style="background-color: #12141a;">
            <h2 class="fw-bold text-white mb-4 text-center">📅 Schedule New Showtime</h2>

            <form asp-action="Create">
                <div class="mb-3">
                    <label class="form-label fw-bold text-white">Select Movie</label>
                    <select asp-for="MovieId" class="form-select bg-dark text-white border-secondary rounded-1" asp-items="ViewBag.MovieId"></select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-white">Date and Time</label>
                    <input asp-for="Showtime" class="form-control bg-dark text-white border-secondary rounded-1" type="datetime-local"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="Showtime" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-white">Cinema Hall</label>
                    <input asp-for="HallName" class="form-control bg-dark text-white border-secondary rounded-1" placeholder="e.g. Hall 1 (IMAX)" value="Hall 1 (IMAX)" />
                    <span asp-validation-for="HallName" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-cinema-orange btn-lg rounded-1 fw-bold shadow-sm">
                        Save Showtime 🚀
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-1">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .btn-cinema-orange {
        background-color: #ff6b00 !important;
        border: 1px solid #ff6b00 !important;
        color: #ffffff !important;
        transition: all 0.2s ease;
    }

        .btn-cinema-orange:hover {
            background-color: #e56000 !important;
            border-color: #e56000 !important;
            box-shadow: 0 0 12px rgba(255, 107, 0, 0.4);
        }
</style>